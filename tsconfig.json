{
  "display": "React Template",
  "extends": "@theholocron/tsconfig/node-lts",
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "paths": {
      "@/package": ["./package.json"],
      "@/*": ["./src/*"]
    },
    "types": ["cypress"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["./node_modules"]
}
