{
  "display": "React Template",
  "extends": "@theholocron/tsconfig/node-lts",
  "compilerOptions": {
    "baseUrl": "./",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "paths": {
      "@/package": ["./package.json"],
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "cypress", "@testing-library/jest-dom"]
  },
  "include": [
    ".astro/types.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "astro.config.ts",
    "docs/src/**/*",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "docs/dist"]
}
