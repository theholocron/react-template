*.so

# Packages
# It's better to unpack these files and commit the raw source because
# git has its own built in compression methods.
*.7z
*.jar
*.rar
*.zip
*.gz
*.bzip
*.xz
*.lzma

# Packing-only formats
*.iso
*.tar

# Package management formats
*.dmg
*.xpi
*.gem
*.egg
*.deb
*.rpm

# Logs and databases
*.log
*.sql
*.sqlite

# Dependency Managers
node_modules
.turbo

# Locally Built Stuff
.astro/
coverage
dist
tsconfig.tsbuildinfo
dist-app
docs/dist/
reports
storybook-static
super-linter-output

