.Spotlight-V100
.Trashes

# Folder config file
Desktop.ini

# NPM
.npmignore

# Ignore these files if present
.yo-rc.json

# Always-ignore extensions
*~
*.diff
*.err
*.lock
*.orig
*.pyc
*.rej
*.sass-cache
*.sw?
*.vi
