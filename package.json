{
  "name": "@theholocron/react-template",
  "version": "0.5.5",
  "description": "A modern React template with pre-configured tools, best practices, and CI/CD setup for rapid project development.",
  "keywords": [
    "react",
    "template",
    "typescript",
    "vite"
  ],
  "homepage": "https://docs.theholocron.dev/react-template/",
  "bugs": "https://github.com/theholocron/react-template/issues",
  "repository": "theholocron/react-template",
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-template.es.js",
      "require": "./dist/react-template.cjs.js",
      "default": "./dist/react-template.cjs.js"
    },
    "./style": "./dist/style.css"
  },
  "style": "./dist/style.css",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "audit": "knip",
    "build": "vite build",
    "build:storybook": "storybook build",
    "build:storybook:chromatic": "STORYBOOK_IS_CHROMATIC=true storybook build",
    "dev": "vite",
    "docs:build": "astro build",
    "docs:dev": "astro dev",
    "docs:preview": "astro preview",
    "lint": "docker run -e LOG_LEVEL=DEBUG -e RUN_LOCAL=true -v .:/tmp/lint --rm ghcr.io/super-linter/super-linter:latest",
    "prepare": "husky && playwright install chromium",
    "prepreview": "pnpm build --config vite.app.config.ts",
    "preview": "vite preview --config vite.app.config.ts",
    "release": "semantic-release",
    "start": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest run --project storybook --coverage",
    "test:cypress": "cypress open",
    "test:storybook": "vitest run --project storybook --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-links": "^10.5.6",
    "@storybook/addon-themes": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/builder-vite": "^10.5.6",
    "@storybook/react": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@theholocron/astro-config": "^7.22.2",
    "@theholocron/cli": "^3.38.1",
    "@theholocron/commitlint-config": "^7.19.1",
    "@theholocron/docs-theme": "^1.3.5",
    "@theholocron/eslint-config": "^7.23.2",
    "@theholocron/holocron-config": "^7.29.0",
    "@theholocron/holocron-plugin-github": "^3.38.1",
    "@theholocron/lighthouse-config": "^7.19.1",
    "@theholocron/lint-staged-config": "^7.19.1",
    "@theholocron/prettier-config": "^7.19.1",
    "@theholocron/semantic-release-config": "^7.19.1",
    "@theholocron/skills": "^1.3.2",
    "@theholocron/storybook-config": "^7.19.1",
    "@theholocron/stylelint-config": "^7.19.1",
    "@theholocron/tsconfig": "^7.19.1",
    "@theholocron/vite-config": "^7.19.1",
    "@theholocron/vitest-config": "^7.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "alex": "^11.0.1",
    "astro": "^7.2.0",
    "axe-playwright": "^2.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "cypress": "^15.19.0",
    "eslint": "^10.8.0",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "msw": "^2.10.4",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "^1.54.1",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semantic-release": "^25.0.8",
    "sort-package-json": "^4.0.0",
    "storybook": "^10.5.6",
    "storybook-addon-pseudo-states": "^10.5.6",
    "tsc-files": "^1.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "cypress",
      "esbuild",
      "msw"
    ],
    "overrides": {
      "@commitlint/config-conventional>conventional-changelog-conventionalcommits": "7",
      "conventional-changelog-conventionalcommits": "9.3.1"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "releases": "https://github.com/theholocron/react-template/releases",
  "wiki": "https://github.com/theholocron/react-template/wiki"
}
